<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000">

    <LinearLayout
        android:id="@+id/widget_quick_input_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:background="#1A2540"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/widget_quick_input_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tugas baru"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/widget_quick_input_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#00000000"
            android:gravity="top|start"
            android:hint="Tambah tugas baru..."
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/widget_quick_input_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#00000000"
            android:hint="HH:mm (opsional)"
            android:inputType="time"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_quick_input_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/widget_quick_input_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Batal"
                android:textSize="13sp" />

            <Button
                android:id="@+id/widget_quick_input_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="#3B82F6"
                android:text="Simpan"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
