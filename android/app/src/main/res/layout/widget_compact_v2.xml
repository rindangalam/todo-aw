<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1729"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Logo -->
        <TextView
            android:id="@+id/widget_compact_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="todoaw"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <!-- Progress text -->
        <TextView
            android:id="@+id/widget_compact_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="12sp"
            android:textColor="#3B82F6" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Next task section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="6dp">

            <TextView
                android:id="@+id/widget_compact_next_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="140dp" />

            <TextView
                android:id="@+id/widget_compact_next_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="#94A3B8" />
        </LinearLayout>

        <!-- Arrow -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="16sp"
            android:textColor="#94A3B8" />

    </LinearLayout>
</FrameLayout>
