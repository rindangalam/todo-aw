<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg_overlay"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header row: title + streak -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Todoaw"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_streak_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_widget_star"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_fire_big"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="3dp"
                android:src="@drawable/ic_sticker_fire_big"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_time_sticker"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_sticker_sparkle"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_manual_sticker"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="3dp"
                android:src="@drawable/ic_sticker_sparkle"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_sticker_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:textSize="20sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:max="100" />

        <!-- Stats row -->
        <TextView
            android:id="@+id/widget_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="9sp" />

        <!-- Task list (max 3 items) -->
        <LinearLayout
            android:id="@+id/widget_task_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/widget_task_bullet_1"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="#88FFFFFF"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/widget_task_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">
                <TextView
                    android:id="@+id/widget_task_bullet_2"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="#88FFFFFF"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/widget_task_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">
                <TextView
                    android:id="@+id/widget_task_bullet_3"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="#88FFFFFF"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/widget_task_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Footer: remaining tasks + add button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <ImageView
                android:id="@+id/widget_remaining_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_widget_target"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_remaining_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textSize="8sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btn_add_task"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_sticker_plus"
                android:padding="2dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
