<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1729"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_today_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="todoaw"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_today_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#94A3B8" />
        </LinearLayout>

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/widget_today_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="0" />

        <!-- Progress text -->
        <TextView
            android:id="@+id/widget_today_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="10sp"
            android:textColor="#94A3B8" />

        <!-- Task list -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <!-- Task row 1 -->
            <LinearLayout
                android:id="@+id/widget_today_task_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_today_checkbox_1"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:text="○"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/widget_today_title_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_today_time_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="10sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>

            <!-- Task row 2 -->
            <LinearLayout
                android:id="@+id/widget_today_task_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_today_checkbox_2"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:text="○"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/widget_today_title_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_today_time_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="10sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>

            <!-- Task row 3 -->
            <LinearLayout
                android:id="@+id/widget_today_task_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_today_checkbox_3"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:text="○"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/widget_today_title_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_today_time_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="10sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>

            <!-- Task row 4 -->
            <LinearLayout
                android:id="@+id/widget_today_task_row_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_today_checkbox_4"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:text="○"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/widget_today_title_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_today_time_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="10sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>

            <!-- Task row 5 -->
            <LinearLayout
                android:id="@+id/widget_today_task_row_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_today_checkbox_5"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:text="○"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/widget_today_title_5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_today_time_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="10sp"
                    android:textColor="#94A3B8" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty state -->
        <TextView
            android:id="@+id/widget_today_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Semua selesai!"
            android:textSize="12sp"
            android:textColor="#94A3B8"
            android:visibility="gone" />

    </LinearLayout>
</FrameLayout>
